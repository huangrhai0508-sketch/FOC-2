  /begin  RECORD_LAYOUT Record_BOOLEAN
    FNC_VALUES 1 UBYTE COLUMN_DIR DIRECT
  /end  RECORD_LAYOUT 

  /begin  RECORD_LAYOUT Record_FLOAT32_IEEE
    FNC_VALUES 1 FLOAT32_IEEE COLUMN_DIR DIRECT
  /end  RECORD_LAYOUT 

  /begin  RECORD_LAYOUT Record_SLONG
    FNC_VALUES 1 SLONG COLUMN_DIR DIRECT
  /end  RECORD_LAYOUT 

  /begin  RECORD_LAYOUT Record_SWORD
    FNC_VALUES 1 SWORD COLUMN_DIR DIRECT
  /end  RECORD_LAYOUT 

  /begin  RECORD_LAYOUT Record_UWORD
    FNC_VALUES 1 UWORD COLUMN_DIR DIRECT
  /end  RECORD_LAYOUT 

  /* Record Layouts for Lookup Tables in Standard Axis format */

  /begin RECORD_LAYOUT ExFeedBackST
    AXIS_PTS_X 2 FLOAT32_IEEE INDEX_INCR DIRECT
    AXIS_PTS_Y 1 FLOAT32_IEEE INDEX_INCR DIRECT
    FNC_VALUES 3 FLOAT32_IEEE COLUMN_DIR DIRECT
  /end RECORD_LAYOUT 

  /begin RECORD_LAYOUT MTPAST
    AXIS_PTS_X 2 FLOAT32_IEEE INDEX_INCR DIRECT
    AXIS_PTS_Y 1 FLOAT32_IEEE INDEX_INCR DIRECT
    FNC_VALUES 3 FLOAT32_IEEE COLUMN_DIR DIRECT
  /end RECORD_LAYOUT 

  /begin RECORD_LAYOUT cLdAdptMonST
    AXIS_PTS_X 2 FLOAT32_IEEE INDEX_INCR DIRECT
    AXIS_PTS_Y 1 FLOAT32_IEEE INDEX_INCR DIRECT
    FNC_VALUES 3 FLOAT32_IEEE COLUMN_DIR DIRECT
  /end RECORD_LAYOUT 

  /begin RECORD_LAYOUT cLqAdptMonST
    AXIS_PTS_X 2 FLOAT32_IEEE INDEX_INCR DIRECT
    AXIS_PTS_Y 1 FLOAT32_IEEE INDEX_INCR DIRECT
    FNC_VALUES 3 FLOAT32_IEEE COLUMN_DIR DIRECT
  /end RECORD_LAYOUT 

  /begin RECORD_LAYOUT cPsiIsqAdptMotSTT
    AXIS_PTS_X 1 FLOAT32_IEEE INDEX_INCR DIRECT
    FNC_VALUES 2 FLOAT32_IEEE COLUMN_DIR DIRECT
  /end RECORD_LAYOUT 


